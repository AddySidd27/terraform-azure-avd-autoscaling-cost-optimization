        <mxCell id="scale" value="&lt;b&gt;Native AVD scaling plan&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Monday-Friday&lt;/b&gt; · 07:00 Ramp-up → 09:00 Peak → 18:00 Ramp-down → 22:00 Off-peak&lt;br&gt;&lt;br&gt;&lt;b&gt;Saturday-Sunday&lt;/b&gt; · 09:00 Ramp-up → 10:00 Peak → 14:00 Ramp-down → 18:00 Off-peak&lt;br&gt;&lt;br&gt;&lt;font color='#506070'&gt;Weekday minimum 50% · Weekend minimum 0% · Start VM on Connect · zero-session shutdown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=14;shadow=1;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="325" width="630" height="205" as="geometry"/></mxCell>
